# Base URL of the VARSHA Weather AI FastAPI backend.
#
# LOCAL DEVELOPMENT: copy to .env.local and point at your local backend:
#   NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8001
#
# PRODUCTION (Vercel): do NOT commit a value here — set NEXT_PUBLIC_API_BASE_URL
# in the Vercel project's Environment Variables (Framework preset shown in the
# dashboard). Example production value:
#   NEXT_PUBLIC_API_BASE_URL=https://your-backend-domain.example
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8001