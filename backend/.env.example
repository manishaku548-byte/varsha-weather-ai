# =====================================================================
# VARSHA Weather AI — backend .env.example
#
# Copy to `.env` ONLY for local development if you want to override
# defaults. Real `.env` files are git-ignored and must NEVER be committed.
# All variables here are NON-SECRET configuration with documented defaults —
# see backend/app/config.py for the canonical list.
#
# On Render / Railway, set these in the platform dashboard / blueprint
# instead of using a .env file.
# =====================================================================

# --- Runtime ---
# Port the web server binds to. Render/Railway inject this automatically;
# the local fallback is 8001. Leave commented out to use the default.
# PORT=8001

# --- Data mode / identity ---
# VARSHA_DATA_MODE=synthetic

# --- Frontend CORS origins (comma-separated, NO wildcard) ---
# Local default is http://localhost:3000,http://127.0.0.1:3000.
# In production set this to your deployed dashboard origin, e.g.:
# VARSHA_CORS_ORIGINS=https://varsha-weather-ai.vercel.app

# --- Paths ---
# Defaults resolve relative to the repository root (the synthetic CSVs are
# tracked and ship with the repo). On free hosting the filesystem is
# EPHEMERAL: writes (SQLite audit log, backtest reports, retrained model
# artifacts) are lost on redeploy unless a persistent disk is mounted here.
# VARSHA_DATA_DIR=./data
# VARSHA_REPORTS_DIR=./data/reports
# VARSHA_MODELS_DIR=./data/models
# VARSHA_DB_URL=sqlite:///./varsha_weather_ai.db

# --- Engine tuning (optional, documented in config.py) ---
# VARSHA_HEALTH_WINDOW_DAYS=14
# VARSHA_MIN_BIAS_HISTORY=10
# VARSHA_MIN_HISTORY_DAYS=14
# VARSHA_MAX_BACKTEST_DATES=366
# VARSHA_ML_INFERENCE=true
# VARSHA_ML_MIN_TRAIN_ROWS=200
# VARSHA_ML_MIN_VAL_ROWS=50
# VARSHA_ML_MIN_TEST_ROWS=50

# --- Testing note ---
# The pytest suite automatically uses varsha_phase1_test.db; it never touches
# your development database.